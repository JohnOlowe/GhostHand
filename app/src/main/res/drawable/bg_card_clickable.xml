<?xml version="1.0" encoding="utf-8"?>
<!--
  The role buttons on the start screen. A StateListDrawable swaps the fill when the
  view is pressed, which is all the touch feedback these big cards need.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_alt" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border" />
        </shape>
    </item>
</selector>
