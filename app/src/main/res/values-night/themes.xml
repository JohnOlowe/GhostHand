<?xml version="1.0" encoding="utf-8"?>
<!--
  Night variant of the theme.

  A style defined in values-night *replaces* the one in values - style items do not
  merge across configurations - so the whole thing has to be repeated here even
  though only the two system-bar icon flags really change (dark bars need light
  icons). Keeping the two files textually identical apart from those two flags makes
  the difference obvious.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
