<?xml version="1.0" encoding="utf-8"?>
<!--
  Guest screen: video first, controls second.

  Layout logic:
  * The root is a FrameLayout so the status pill can float on top of the video.
  * videoContainer is centred and its size is set from Java to match the stream's
    aspect ratio (letterboxing). The SurfaceView inside it is match_parent, so the
    decoder always renders into exactly the right rectangle.
  * panelConnect holds everything you need *before* a stream exists; it is hidden
    once video starts so the picture can use the whole screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/video_background"
    android:keepScreenOn="true">

    <!-- ============================== video =============================== -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@color/video_background">

        <SurfaceView
            android:id="@+id/surfaceVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/txtOverlay"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="@string/guest_status_idle" />
    </FrameLayout>

    <!-- ========================= floating status ========================== -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_status" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/guest_status_idle"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===================== connect / discovery panel ==================== -->
    <ScrollView
        android:id="@+id/panelConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg"
        android:fillViewport="false"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_guest"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtGuestHint"
                style="@style/Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/guest_status_idle"
                android:textSize="12sp" />

            <!-- manual entry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtHost"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/bg_input"
                    android:digits="0123456789.:"
                    android:hint="@string/guest_hint_ip"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnConnect"
                    style="@style/Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="120dp"
                    android:text="@string/guest_connect" />
            </LinearLayout>

            <!-- discovered hosts -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/guest_status_discovering" />

            <LinearLayout
                android:id="@+id/listHosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNoHosts"
                    style="@style/Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guest_discovered_none"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- live stats + log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtStatFps"
                    style="@style/Text.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    tools:text="30 fps" />

                <TextView
                    android:id="@+id/txtStatSize"
                    style="@style/Text.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="12sp"
                    tools:text="1088x2336" />

                <TextView
                    android:id="@+id/txtStatPing"
                    style="@style/Text.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="12sp"
                    tools:text="rtt 12 ms" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLog"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_alt"
                android:minHeight="96dp"
                android:padding="12dp"
                android:textSize="11sp"
                tools:text="discovery started" />

            <Button
                android:id="@+id/btnDisconnect"
                style="@style/Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/guest_disconnect" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
