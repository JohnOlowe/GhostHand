<?xml version="1.0" encoding="utf-8"?>
<!--
  Guest screen.

  A FrameLayout because the video has to be able to fill the whole window while the
  status pill and the connect panel float on top of it. The panel is a
  MaterialCardView holding a TextInputLayout for the host IP, a RecyclerView for
  discovered hosts and MaterialButtons; it is hidden once the stream is up, which is
  what turns this into a full-screen viewer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/video_background"
    android:fitsSystemWindows="true">

    <!-- The video. Letterboxed at runtime by resizing this container to the
         stream's aspect ratio, so MediaCodec always renders into a correctly
         shaped Surface instead of stretching. -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surfaceVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/txtOverlay"
            style="@style/Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/guest_status_idle"
            android:textColor="@color/text_primary" />
    </FrameLayout>

    <!-- Status pill, top-left. -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <View
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_status" />

        <TextView
            android:id="@+id/txtStatus"
            style="@style/Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/guest_status_idle"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Host navigation as four buttons: back, home, recents, notification shade.
         They sit in the ROOT frame (not inside videoContainer), so their taps are
         consumed here and never reach the touch-forwarding listener - everything
         outside this bar still goes to the video, and hence to the host. Visible
         only while connected; immersive mode keeps it on screen, which is exactly
         when it is needed. -->
    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_pill"
        android:orientation="vertical"
        android:padding="2dp"
        android:visibility="gone">

        <!-- Row 1: system navigation + display rotation. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/guest_nav_back"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavHome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/guest_nav_home"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRecents"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/guest_nav_recents"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavShade"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/guest_nav_shade"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRotate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/guest_nav_rotate"
            android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 2: clipboard bridge - push mine / pull the host's. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClipToHost"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/guest_clip_to_host"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClipFromHost"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="@string/guest_clip_from_host"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== connect / detail panel ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panelConnect"
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/guest_host_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/boxHost"
                    style="@style/Input.Host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/guest_hint_ip">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:fontFamily="monospace" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="52dp"
                    android:text="@string/guest_connect"
                    app:cornerRadius="14dp" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/guest_hosts_label" />

                <!-- Discovered hosts. A RecyclerView instead of inflating rows into a
                     LinearLayout: view recycling matters as soon as a network has
                     more than a couple of devices announcing themselves. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listHosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_host" />

                <TextView
                    android:id="@+id/txtNoHosts"
                    style="@style/Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/guest_discovered_none"
                    android:textSize="12sp" />

                <!-- ===================== live stats ===================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guest_stat_fps" />

                        <TextView
                            android:id="@+id/txtStatFps"
                            style="@style/Stat.Value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guest_stat_size" />

                        <TextView
                            android:id="@+id/txtStatSize"
                            style="@style/Stat.Value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guest_stat_ping" />

                        <TextView
                            android:id="@+id/txtStatPing"
                            style="@style/Stat.Value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/txtLog"
                        style="@style/Text.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp" />
                </ScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:enabled="false"
                    android:text="@string/guest_disconnect" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
