<?xml version="1.0" encoding="utf-8"?>
<!--
  Host control panel. Everything the user needs to answer three questions:
  "am I streaming?", "what address do I read out to the other phone?",
  "how healthy is the stream?".
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============================ status ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/txtStatus"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/host_status_idle"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusDetail"
            style="@style/Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="1088x2336 · 0 guests" />

        <!-- =========================== address ============================ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/host_address_label" />

            <TextView
                android:id="@+id/txtAddress"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/host_address_unknown"
                android:textIsSelectable="true"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopy"
                    style="@style/Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/host_copy" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/host_share" />
            </LinearLayout>
        </LinearLayout>

        <!-- =========================== controls =========================== -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/host_resolution" />

            <Spinner
                android:id="@+id/spnResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:entries="@array/host_resolution_options"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Switch
                android:id="@+id/swMirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:checked="true"
                android:text="@string/host_mode_mirror"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnToggle"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="@string/host_start"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtHint"
                style="@style/Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/host_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ============================= stats ============================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtStatFps"
                    style="@style/Stat.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/host_stat_fps" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtStatBitrate"
                    style="@style/Stat.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/host_stat_bitrate" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtStatClients"
                    style="@style/Stat.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/host_stat_clients" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtStatDropped"
                    style="@style/Stat.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/host_stat_dropped" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================== log ============================== -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/host_log_title" />

        <TextView
            android:id="@+id/txtLog"
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_alt"
            android:minHeight="140dp"
            android:padding="12dp"
            android:textSize="11sp"
            tools:text="listening on port 47811" />

        <Button
            android:id="@+id/btnGuestMode"
            style="@style/Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/host_guest_mode" />

        <TextView
            style="@style/Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/host_guest_mode_note"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
