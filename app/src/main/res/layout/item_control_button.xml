<?xml version="1.0" encoding="utf-8"?>
<!--
  One button in the guest's dynamic control bar. Inflated for every id in
  ControlsConfig.BUTTON_IDS and for the structural buttons (x, a, Settings),
  so every bar state wears exactly the same clothes.
-->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Material3.Button.TextButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:textColor="@color/pill_text"
    android:textSize="12sp" />
