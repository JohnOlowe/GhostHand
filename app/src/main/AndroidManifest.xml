<?xml version="1.0" encoding="utf-8"?>
<!--
  The `package` attribute is the application ID. Gradle normally injects it from
  applicationId in build.gradle, but aapt2 (the toolchain build) reads it from
  here, so it is stated explicitly and the two agree: damjay.control.ghosthand.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="damjay.control.ghosthand">

    <!-- ============================ PERMISSIONS ============================ -->

    <!-- Sockets: the host listens on a TCP port, the guest dials it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Volume buttons: AudioManager.adjustStreamVolume needs only this
         normal-level permission, which is what makes Vol+/Vol- work with no
         accessibility service and no Shizuku on any supported host. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Reading WiFi state / interfaces so the host can print "connect to 192.168.x.x". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- MediaProjection has to live inside a foreground service (Android 10+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Android 14 (API 34) split FOREGROUND_SERVICE into per-type permissions.
      Without this exact one, startForeground(..., FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION)
      throws SecurityException on API 34+. On API 26-33 the permission is ignored.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ needs a runtime grant to show the "Mirroring" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the encode/send loop alive if the host screen goes dark. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 11+ package visibility: needed to tell "Shizuku is not installed"
         apart from "Shizuku is installed but not running" in the host's log. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="UnusedAttribute">

        <!-- ============================ SPLASH ============================ -->
        <!--
          The launcher entry point. The icon opens this, not MainActivity: the animation
          is the first thing the app shows, and SplashActivity starts MainActivity itself
          after two taps of the glass. Keeping the launcher filter in one place (here)
          also means the app has exactly one entry point, which is what the back stack
          wants: from the role picker, Back returns to the launcher, not to the splash.
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GhostHand.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================= ROLE PICKER ========================= -->
        <!--
          Reached from the splash and from anywhere that wants the role picker. Not
          exported: nothing outside the app should be able to start it directly, and the
          only thing that does is our own SplashActivity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- ============================ HOST ============================== -->
        <!--
          NOT orientation-locked: when the host rotates, onConfigurationChanged fires
          in the service and we push a GEOMETRY frame so the guest can re-letterbox.
          configChanges keeps the activity (and its log view) alive across rotation.
        -->
        <activity
            android:name=".HostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/title_host" />

        <!-- ============================ GUEST ============================= -->
        <activity
            android:name=".GuestActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/title_guest" />

        <!-- ======================= CAPTURE SERVICE ======================== -->
        <!--
          foregroundServiceType="mediaProjection" is what lets this service own the
          MediaProjection object. Android 14+ requires:
            1. this attribute,
            2. the FOREGROUND_SERVICE_MEDIA_PROJECTION permission above,
            3. startForeground() to be called BEFORE getMediaProjection().
          exported=false: only our own activities may start it.
        -->
        <service
            android:name=".host.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ===================== TOUCH INJECTION (milestone 2) ============ -->
        <!--
          Declares the accessibility service that performs the guest's touches here.

          Two attributes are non-negotiable:
            * android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
              means only the SYSTEM may bind to this service. Without it any app
              could connect and drive the injector - it is the security boundary of
              the whole feature, not boilerplate.
            * android:exported="true" is required the other way round: the system is
              a different process, so it must be able to reach the service.

          The service does nothing until the user enables it in
          Settings -> Accessibility (canPerformGestures in the referenced config XML
          is what allows dispatchGesture once they do).
        -->
        <service
            android:name=".host.InjectionAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ======================= SHIZUKU (optional) ==================== -->
        <!--
          The binder handshake from the official Shizuku client API - see
          toolchain/shizuku/PROVENANCE.md. Authorities are applicationId.shizuku,
          written out because aapt2 (unlike Gradle) does not substitute
          ${applicationId}. INTERACT_ACROSS_USERS_FULL guards the provider so
          only privileged callers (the Shizuku server runs as shell/root) can
          touch it; ordinary apps are stopped at the provider itself.
          Without Shizuku installed and granted, nothing here activates - the
          app's rotation falls back to the window-level path every time.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="damjay.control.ghosthand.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
